{
  "description": "Record agent and tool events for team-status live view.",
  "hooks": {
    "SubagentStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": [
              "-I",
              "${CLAUDE_PLUGIN_ROOT}/scripts/team-event"
            ],
            "timeout": 5
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": [
              "-I",
              "${CLAUDE_PLUGIN_ROOT}/scripts/team-event"
            ],
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": [
              "-I",
              "${CLAUDE_PLUGIN_ROOT}/scripts/team-event"
            ],
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": [
              "-I",
              "${CLAUDE_PLUGIN_ROOT}/scripts/team-event"
            ],
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": [
              "-I",
              "${CLAUDE_PLUGIN_ROOT}/scripts/team-event"
            ],
            "timeout": 5
          }
        ]
      }
    ]
  }
}
